[Unit]
Description=霓虹酒馆用户版生成任务
After=network-online.target neon-tavern-user-web.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/neon-tavern-user/current
EnvironmentFile=/etc/neon-tavern-user/environment
ExecStart=/opt/neon-tavern-user/current/venv/bin/python manage.py run_generation_worker
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/neon-tavern-user

[Install]
WantedBy=multi-user.target
