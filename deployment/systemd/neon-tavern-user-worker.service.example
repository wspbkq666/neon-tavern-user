[Unit]
Description=Neon Tavern AI generation worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/neon-tavern-user/current
EnvironmentFile=/etc/neon-tavern-user.env
ExecStart=/opt/neon-tavern-user/current/venv/bin/python manage.py run_generation_worker
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
