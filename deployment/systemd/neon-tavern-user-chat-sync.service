[Unit]
Description=霓虹酒馆用户版双总站数据同步
After=network-online.target neon-tavern-user-web.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/neon-tavern-user/current
EnvironmentFile=/etc/neon-tavern-user/environment
LoadCredential=federation-private-key-154:/etc/neon-tavern-user/credentials/federation-private-key-154.pem
LoadCredential=federation-private-key-123:/etc/neon-tavern-user/credentials/federation-private-key-123.pem
Environment=TAVERN_FEDERATION_PRIVATE_KEY_FILE=%d/federation-private-key-154
Environment=TAVERN_FEDERATION_MAIN_123_PRIVATE_KEY_FILE=%d/federation-private-key-123
ExecStart=/opt/neon-tavern-user/current/venv/bin/python manage.py sync_chat_mirror
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/neon-tavern-user
