[Unit]
Description=霓虹酒馆一致性加密灾备快照
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/srv/neon-tavern-app/current/backend
EnvironmentFile=/etc/neon-tavern-dr.env
ExecStart=/srv/neon-tavern-app/venv/bin/python manage.py create_dr_snapshot
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/neon-tavern
