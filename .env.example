# Django 实际读取的服务端变量；部署前替换密钥并限制允许的主机名。
TAVERN_SECRET_KEY=replace-with-a-long-random-secret
TAVERN_DEBUG=0
TAVERN_ENCRYPTION_KEY=replace-with-a-32-byte-url-safe-base64-key
# Set to 1 only when intentionally using direct HTTP without a certificate.
TAVERN_INSECURE_HTTP=0
TAVERN_ALLOWED_HOSTS=127.0.0.1,localhost
TAVERN_CSRF_ORIGINS=
TAVERN_DB_PATH=/var/lib/neon-tavern/db.sqlite3
TAVERN_MEDIA_ROOT=/var/lib/neon-tavern/media

# 双站容灾默认关闭。完成双机部署、初始快照和用户同意后才设为 1。
TAVERN_DR_ENABLED=0
TAVERN_NODE_ID=154
TAVERN_DR_READ_ONLY=0
TAVERN_DR_USE_REPLICA_ACTIVE=0
TAVERN_DR_REPLICA_ROOT=/var/lib/neon-tavern/replica
TAVERN_DR_LEASE_PATH=/var/lib/neon-tavern/dr-lease.json
TAVERN_DR_ROLE_PATH=/var/lib/neon-tavern/dr-role.json
TAVERN_DR_STATUS_PATH=/var/lib/neon-tavern/dr-status.json
TAVERN_DR_SNAPSHOT_DIR=/var/lib/neon-tavern/snapshots
TAVERN_DR_SNAPSHOT_LOCK_PATH=/var/lib/neon-tavern/dr-snapshot.lock
TAVERN_DR_ENCRYPTION_KEY_VERSION=v1
TAVERN_DR_ENCRYPTION_KEY=replace-with-the-same-32-byte-key-on-both-sites
TAVERN_DR_ALLOW_HTTP_PEER=0
TAVERN_DR_HTTP_PEER_HOSTS=
TAVERN_DR_NODE_PRIVATE_KEY=replace-with-this-node-private-key
TAVERN_DR_TRUSTED_NODE_PUBLIC_KEYS={}
TAVERN_WITNESS_URL=https://hbe3.wch1.top:43111
TAVERN_WITNESS_CA_BUNDLE=/etc/neon-tavern/witness-ca.pem
TAVERN_WITNESS_PUBLIC_KEY=replace-with-witness-public-key
TAVERN_DR_PEER_URL=https://123.56.125.209
TAVERN_DR_STANDBY_NODE_ID=123
TAVERN_DR_STANDBY_ORIGIN=https://123.56.125.209
TAVERN_DR_STATUS_ALLOWED_ORIGINS=http://154.222.26.47:8088,https://123.56.125.209

